# ─── Lấy repo đã ghim từ GitHub (tuỳ chọn) ───────────────────────────────
# Danh sách repo ghim (pinned) chỉ có ở GraphQL API, mà GraphQL thì bắt buộc
# phải xác thực — kể cả khi chỉ đọc dữ liệu công khai.
#
# Không khai báo cũng chạy: trang sẽ tự lấy các repo công khai nhiều sao nhất
# thay cho danh sách ghim.
#
# Tạo token tại https://github.com/settings/tokens
#   - Fine-grained: không cần cấp quyền nào cả (chỉ đọc dữ liệu công khai)
#   - Classic: tick "read:user" là đủ
GITHUB_TOKEN=

# ─── Gửi mail cho form liên hệ (tuỳ chọn) ────────────────────────────────
# Không khai báo cũng không sao: form vẫn chạy, nhưng thay vì gửi thư nó sẽ
# hiện link mailto để khách tự gửi bằng ứng dụng mail của họ.
#
# Lấy khoá tại https://resend.com/api-keys
RESEND_API_KEY=

# Địa chỉ gửi đi. Muốn dùng tên miền riêng thì phải xác minh domain ở Resend.
# Bỏ trống sẽ dùng địa chỉ thử nghiệm onboarding@resend.dev
CONTACT_FROM="gitbot.io <onboarding@resend.dev>"

# Hộp thư nhận tin nhắn. Bỏ trống sẽ lấy profile.contact.inbox trong
# src/data/profile.ts
CONTACT_TO=
